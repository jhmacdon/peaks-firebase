      "CHECK ((((state = ANY (ARRAY['reviewing'::text, 'publish_leased'::text, 'verify_leased'::text])) AND (lease_owner IS NOT NULL) AND (lease_token IS NOT NULL) AND (lease_expires_at IS NOT NULL)) OR ((state <> ALL (ARRAY['reviewing'::text, 'publish_leased'::text, 'verify_leased'::text])) AND (lease_owner IS NULL) AND (lease_token IS NULL) AND (lease_expires_at IS NULL))))",
