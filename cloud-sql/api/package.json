{
  "name": "peaks-api",
  "version": "1.0.0",
  "description": "Peaks Cloud Run API — PostGIS query layer with Firebase Auth",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_ENV=test node --test --import tsx src/__tests__/*.test.ts",
    "test:db": "NODE_ENV=test node --test --test-concurrency=${TEST_CONCURRENCY:-6} --import tsx src/__tests__/*.test.ts",
    "test:db:provision": "../test-db/provision.sh",
    "backfill:area-descriptions": "tsx scripts/backfill-area-descriptions.ts",
    "backfill:session-areas": "tsx scripts/backfill-session-areas.ts",
    "weather:refresh": "tsx scripts/run-weather-refresh.ts"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "express": "^4.21.0",
    "firebase-admin": "^13.0.0",
    "google-auth-library": "^10.0.0",
    "pg": "^8.13.0",
    "pg-query-stream": "^4.15.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.39.4",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.2"
  },
  "private": true
}
