rules_version = '2';
service cloud.firestore {
	match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /sessions/{sessionId} {
      // Raw activity documents can contain markers, health data, and other
      // owner-only fields. Public activity pages read a sanitized SQL bundle.
      allow read: if isSessionOwner();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSessionOwner()
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSessionOwner();

      function isSessionOwner() {
        return signedIn() && resource.data.userId == request.auth.uid;
      }
    }
    match /feedback/{document=**} {
      allow read, write: if request.auth.uid != null;
    }
    match /points/{sessionId} {
      // Public activity pages never read the unredacted Firestore point blob.
      allow read: if isSessionOwner();
      allow create, update: if isSessionOwner();
      allow delete: if isSessionOwner();

      function session() {
        return get(/databases/$(database)/documents/sessions/$(sessionId));
      }

      function isSessionOwner() {
        return signedIn() && session().data.userId == request.auth.uid;
      }
    }
    match /destinations/{document=**} {
    	allow read: if true;
      allow write: if request.auth.uid != null;
    }
    match /averages/{document=**} {
    	allow read: if true;
      allow write: if request.auth.uid != null;
    }
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == uid;

      match /savedDestinations/{destinationId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == uid;
      }

      match /savedPlaces/{placeId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == uid;
      }
    }
    match /plans/{planId} {
      // Public route pages read a field-limited Cloud SQL bundle. Keep the
      // legacy Firestore document private because rules cannot redact fields.
      allow read: if isPlanOwnerOrMember();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isPlanOwner()
        && request.resource.data.userId == resource.data.userId;
      allow update: if isPlanMember()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get("party", []) == resource.data.get("party", [])
        && request.resource.data.get("isPublic", false) == resource.data.get("isPublic", false);
      allow delete: if isPlanOwner();

      function isPlanOwner() {
        return signedIn() && resource.data.userId == request.auth.uid;
      }

      function isPlanMember() {
        return signedIn() && request.auth.uid in resource.data.get("party", []);
      }

      function isPlanOwnerOrMember() {
        return isPlanOwner() || isPlanMember();
      }
    }
    match /routes/{routeId} {
      allow read: if resource.data.owner == "peaks"
        || (signedIn() && resource.data.owner == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner;
      allow delete: if signedIn()
        && resource.data.owner == request.auth.uid;
    }
    match /lists/{document=**} {
    	allow read: if true;
      allow write, delete: if request.resource.data.owner == request.auth.uid;
    }
    match /weather/{document=**} {
    	allow read: if true;
      allow write, delete: if false;
    }
    match /invites/{document=**} {
    	allow read: if request.auth.uid != null;
      allow write: if forSelfOrOwned();
      
      function forSelfOrOwned() {
        return request.auth.uid == request.resource.data.userId || get(/databases/$(database)/documents/plans/$(request.resource.data.planId)).data.userId == request.auth.uid
    	}
    }
    match /tripReports/{reportId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
